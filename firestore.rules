rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function currentUserRole() {
      return signedIn() && userDoc() != null && userDoc().data.role is string
        ? userDoc().data.role.lower()
        : "";
    }

    function hasRole(role) {
      return currentUserRole() == role.lower();
    }

    function hasAnyRole(roles) {
      return signedIn() && currentUserRole() in roles;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isOpsManager() {
      return hasRole("opsmanager");
    }

    function isOpsUser() {
      return hasRole("opsuser");
    }

    function isFleetManager() {
      return hasRole("fleetmanager");
    }

    function isAuditor() {
      return hasRole("auditor");
    }

    function isAccounts() {
      return hasRole("accounts");
    }

    function isDriver() {
      return hasRole("driver");
    }

    function isCustomer() {
      return hasRole("customer");
    }

    function isOpsStaff() {
      return hasAnyRole(["opsuser", "opsmanager"]);
    }

    function isStaff() {
      return hasAnyRole([
        "admin",
        "opsuser",
        "opsmanager",
        "fleetmanager",
        "auditor",
        "accounts",
      ]);
    }

    function canManageUsers() {
      return signedIn() && (isAdmin() || isOpsManager());
    }

    function selfUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function selfUserCreateAllowed(userId) {
      return selfUserDoc(userId)
        && request.resource.data.role is string
        && request.resource.data.role == "customer"
        && request.resource.data.email is string
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email;
    }

    function selfUserUpdateAllowed(userId) {
      return selfUserDoc(userId)
        && request.resource.data.role == resource.data.role
        && (
          !(resource.data.accountStatus is string)
          || request.resource.data.accountStatus == resource.data.accountStatus
        )
        && (
          !(resource.data.accountType is string)
          || request.resource.data.accountType == resource.data.accountType
        )
        && (
          !(resource.data.emailVerified is bool)
          || request.resource.data.emailVerified == resource.data.emailVerified
        )
        && (
          !(resource.data.email is string)
          || request.resource.data.email == resource.data.email
        );
    }

    function requestEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function resourceEmail(resourceData) {
      return resourceData.customerEmail is string
        ? resourceData.customerEmail.lower()
        : resourceData.email is string
          ? resourceData.email.lower()
          : "";
    }

    function ownsByUid(resourceData) {
      return signedIn()
        && (
          (resourceData.customerUid is string && resourceData.customerUid == request.auth.uid)
          || (resourceData.uid is string && resourceData.uid == request.auth.uid)
        );
    }

    function ownsByEmail(resourceData) {
      return signedIn()
        && requestEmail() != ""
        && resourceEmail(resourceData) == requestEmail();
    }

    function ownsResource(resourceData) {
      return ownsByUid(resourceData) || ownsByEmail(resourceData);
    }

    function driverTruckId() {
      return signedIn() && userDoc() != null && userDoc().data.assignedTruckId is string
        ? userDoc().data.assignedTruckId.lower()
        : signedIn() && userDoc() != null && userDoc().data.truckId is string
          ? userDoc().data.truckId.lower()
          : signedIn() && userDoc() != null && userDoc().data.vehicleId is string
            ? userDoc().data.vehicleId.lower()
            : "";
    }

    function notificationTargetsCurrentUser(resourceData) {
      return signedIn() && (
        (resourceData.targetUid is string && resourceData.targetUid == request.auth.uid)
        || (resourceData.targetEmail is string && resourceData.targetEmail.lower() == requestEmail())
        || (resourceData.targetRole is string && resourceData.targetRole.lower() == currentUserRole())
        || (
          isDriver()
          && driverTruckId() != ""
          && resourceData.targetTruckId is string
          && resourceData.targetTruckId.lower() == driverTruckId()
        )
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if canManageUsers() || selfUserCreateAllowed(userId);
      allow update: if canManageUsers() || selfUserUpdateAllowed(userId);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.auth.uid == customerId || isAdmin() || isOpsStaff());
      allow update: if signedIn() && (request.auth.uid == customerId || isAdmin() || isOpsStaff());
      allow delete: if isAdmin();
    }

    match /Quotations/{quotationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin()
        || isOpsStaff()
        || ownsResource(resource.data)
      );
      allow delete: if signedIn() && (isAdmin() || isOpsStaff());
    }

    match /customer_order/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isAdmin()
        || isOpsStaff()
        || isFleetManager()
        || ownsResource(request.resource.data)
      );
      allow update: if signedIn() && (
        isAdmin()
        || isOpsStaff()
        || isFleetManager()
        || isAccounts()
      );
      allow delete: if signedIn() && (isAdmin() || isOpsStaff());
    }

    match /order_shipments/{shipmentId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isAdmin() || isOpsStaff() || isFleetManager());
    }

    match /order_issues/{issueId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isAdmin() || isOpsStaff());
    }

    match /customer_orders/{orderId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && canManageUsers();
    }

    match /customer_support/{supportId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && canManageUsers();
    }

    match /fleet_vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isAdmin() || isFleetManager());
    }

    match /fleet_drivers/{driverId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isAdmin() || isFleetManager());
    }

    match /fleet_routes/{routeId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isAdmin() || isFleetManager());
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdmin()
        || notificationTargetsCurrentUser(resource.data)
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin()
        || notificationTargetsCurrentUser(resource.data)
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
